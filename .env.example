# indic-rag-evals -- environment template
#
# Copy to `.env` and fill in real values if you want them in your shell.
# `.env` is git-ignored; only this template is committed. NEVER commit keys.
#
# IMPORTANT: the harness does NOT auto-load `.env` (that would need a
# third-party package). Export the variables yourself, e.g.:
#     set -a; source .env; set +a
#
# The default path needs NONE of these:
#   - strategies bm25 / char-gram / hybrid  -> stdlib only
#   - generator extractive                  -> stdlib only
#   - `python3 -m unittest discover ...`    -> stdlib only

# ---------------------------------------------------------------------------
# Optional: LLM generation  (`rageval evaluate --generator llm`)
# Speaks the OpenAI-compatible POST {base}/chat/completions protocol.
# ---------------------------------------------------------------------------

# Required for --generator llm (checked in this order: SARVAM_API_KEY,
# then LLM_API_KEY).
SARVAM_API_KEY=

# Base URL of an OpenAI-compatible endpoint. Used only when LLM_BASE_URL is
# empty (precedence: LLM_BASE_URL > SARVAM_API_BASE > this default).
SARVAM_API_BASE=https://api.sarvam.ai/v1

# Model id to request (precedence: LLM_MODEL > SARVAM_MODEL > sarvam-m).
# Check your provider's docs for the current model ids before running.
SARVAM_MODEL=sarvam-m

# Generic aliases, handy for non-Sarvam gateways (vLLM, Ollama, LiteLLM...).
# An OpenAI-compatible local gateway is usually just http://localhost:8000/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---------------------------------------------------------------------------
# Optional: dense retrieval  (`rageval evaluate --strategies hybrid+dense`)
# Requires: pip install sentence-transformers
# ---------------------------------------------------------------------------
RAGEVAL_DENSE_MODEL=paraphrase-multilingual-MiniLM-L12-v2
