# Python artefacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets -- .env is never committed; only .env.example is
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Evaluation outputs are regenerated by `rageval evaluate`
results/*
!results/.gitkeep

# Editor / OS noise
.idea/
.vscode/
.DS_Store
